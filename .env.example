# Server
PORT=3001
HOST=0.0.0.0
DEBUG=false

# Scraper
TRACKING_URL=https://tracking.post.ir/
TIMEOUT_SECONDS=20
MAX_RETRIES=5
RETRY_SLEEP_SECONDS=1.5

# TLS impersonation target for curl_cffi.
# Allows Python to send a real Chrome JA3/JA4 fingerprint and bypass
# servers that block non-browser TLS ClientHellos.
# Valid values: chrome124, chrome120, chrome110, chrome107,
#               safari17_0, safari15_5, edge99, firefox117, etc.
# See: https://curl-cffi.readthedocs.io/en/latest/impersonate.html
IMPERSONATE=chrome124

